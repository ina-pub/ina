{
  "files": { "includes": ["**"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": {
    "formatter": { "quoteStyle": "single", "semicolons": "asNeeded", "trailingCommas": "none" }
  },
  "css": {
    "formatter": { "quoteStyle": "single" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": { "noVar": "error", "noDoubleEquals": "error" },
      "security": { "noGlobalEval": "error" }
    }
  },
  "overrides": [
    {
      "includes": ["static/css/**"],
      "linter": {
        "rules": {
          "style": { "noDescendingSpecificity": "off" }
        }
      }
    }
  ]
}
