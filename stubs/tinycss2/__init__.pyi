# The parts of tinycss2 the app uses; it ships no type information.
from collections.abc import Iterable, Sequence

from tinycss2.ast import Declaration, Node, ParseError

def parse_stylesheet(
    css: str, skip_comments: bool = ..., skip_whitespace: bool = ...
) -> list[Node]: ...
def parse_rule_list(
    input: str | Sequence[Node], skip_comments: bool = ..., skip_whitespace: bool = ...
) -> list[Node]: ...
def parse_blocks_contents(
    input: str | Sequence[Node], skip_comments: bool = ..., skip_whitespace: bool = ...
) -> list[Node]: ...
def parse_declaration_list(
    input: str | Sequence[Node], skip_comments: bool = ..., skip_whitespace: bool = ...
) -> list[Declaration | ParseError | Node]: ...
def parse_component_value_list(css: str, skip_comments: bool = ...) -> list[Node]: ...
def serialize(nodes: Iterable[Node]) -> str: ...
